# grill이 만든 커스텀 노드 이미지: PyTorch 바탕(공용 이미지와 같은 층) + ComfyUI + 이 워크플로의 커스텀 노드
# 빌드 폴더: 이 Dockerfile + workflow.json
FROM ghcr.io/imgu418/grill-comfy@sha256:d2c0ee9b4a3782a810a3b92d18be3ece2b38a7b89bf77f6618d3b3218b863452 AS grill
FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_BREAK_SYSTEM_PACKAGES=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/grill
# git: ComfyUI 매니저가 노드 저장소를 받는 데 쓴다
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=grill /opt/ComfyUI /opt/ComfyUI
COPY --from=grill /opt/grill /opt/grill
COPY workflow.json /tmp/grill-build/workflow.json
# PyTorch 바탕의 torch 계열(CUDA 판) 버전을 고정한다
RUN echo  | base64 -d | GRILL_DEPS_PINS=1 python
ENV PIP_CONSTRAINT=/opt/grill-constraints.txt
# ComfyUI 의존성 (매니저가 노드를 설치할 때 쓰는 환경). 노드 것과 맞지 않는 버전은 아래에서 함께 다시 푼다
RUN pip install -r /opt/ComfyUI/requirements.txt && rm -rf /root/.cache
RUN pip install comfyui_manager==4.2.2 \
  && export COMFYUI_PATH=/opt/ComfyUI \
  && python -m cm_cli deps-in-workflow --workflow /tmp/grill-build/workflow.json --output /tmp/grill-build/deps.json --mode remote \
  && python -m cm_cli install-deps /tmp/grill-build/deps.json --mode remote \
  && pip uninstall -y comfyui_manager \
  && for d in /opt/ComfyUI/custom_nodes/*/; do if [ -d "$d.git" ]; then echo "$(git -C "$d" remote get-url origin) $(git -C "$d" rev-parse HEAD)" >> /opt/ComfyUI/custom_nodes/grill-nodes.txt; fi; done \
  && rm -rf /root/.cache /opt/ComfyUI/user/__manager
# ComfyUI와 노드 묶음의 파이썬 의존성을 한 번에 풀어 설치한다: GRILL-DEPS 줄
RUN echo  | base64 -d | python && rm -rf /root/.cache
RUN python -m compileall -q /opt/ComfyUI/custom_nodes > /dev/null || true
# 노드 코드에 적힌 모델 다운로드 주소와 Hugging Face 저장소 (grill이 모델 받을 곳을 찾는 데 쓴다): GRILL-URL / GRILL-REPO 줄
RUN echo  | base64 -d | python
# 워크플로의 노드가 모두 들어갔는지 확인 (없으면 빌드 실패)
RUN python -m grill_comfy --check /tmp/grill-build/workflow.json && rm -rf /tmp/grill-build /tmp/grill-comfy
WORKDIR /opt/ComfyUI
EXPOSE 8188
CMD ["python", "-m", "grill_comfy"]
